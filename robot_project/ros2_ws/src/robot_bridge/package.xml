<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bridge</name>
  <version>1.0.0</version>
  <description>ROS 2 hardware bridge to ESP32 Motion Controller over Serial UART or CAN Bus.</description>
  <maintainer email="premkumar@example.com">PREM KUMAR</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>robot_interfaces</depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-can</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
