# SpeakText.action
# Action for triggering offline text-to-speech output

# Goal
string text              # String to speak
string voice_profile     # Voice name / profile (e.g. "default", "cybernetic", "science")
bool sync_lip_movement   # Sync SSD1306 OLED talking animation

---
# Result
bool success
float32 speaking_duration_seconds

---
# Feedback
float32 progress_percentage # 0.0 to 100.0
string current_word
